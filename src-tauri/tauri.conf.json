{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keystore Studio",
  "version": "1.0.0",
  "identifier": "io.keystorestudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keystore Studio",
        "dragDropEnabled": true,
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ajaykontham",
    "category": "DeveloperTool",
    "shortDescription": "Keystore and X.509 certificate workbench",
    "longDescription": "Create, open, edit and convert PKCS#12, JKS and JCEKS keystores; issue certificates, sign CSRs, CRLs, JARs, CMS payloads and JWTs; inspect live TLS servers and certificate files.",
    "copyright": "© Ajay Kontham. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
